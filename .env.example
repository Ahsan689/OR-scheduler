# Copy to .env and adjust. Never commit the real .env.

# ---- Postgres (docker compose) ----
POSTGRES_USER=orflow
POSTGRES_PASSWORD=orflow
POSTGRES_DB=orflow

# ---- Backend ----
# For local (host) runs use localhost; inside docker compose use the db host.
DATABASE_URL=postgresql+psycopg://orflow:orflow@localhost:5432/orflow
ENVIRONMENT=development
DEBUG=false
# Comma-separated list is also accepted by pydantic-settings.
CORS_ORIGINS=["http://localhost:3000"]

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
